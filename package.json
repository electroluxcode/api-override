{
  "name": "api-override",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @api-override/extension dev",
    "serve": "node scripts/serve.mjs",
    "dev:extension": "pnpm --filter @api-override/extension dev",
    "build": "pnpm --filter @api-override/extension build",
    "build:extension": "pnpm --filter @api-override/extension build",
    "test": "pnpm build",
    "package": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/chrome": "^0.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "mockjs": "^1.1.0"
  }
}
